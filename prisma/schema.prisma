// Schema Prisma — App Quản Lý Cá Nhân Đa Năng
//
// AD-1: mỗi module sở hữu độc quyền tập model của riêng nó. Các model dưới đây
//       thuộc module Lịch trình (`app/lich-trinh`). Module khác không được
//       import/query trực tiếp chúng.
// AD-5: không có model User/Session/Account và không có cột phân vùng tenant.
// AD-6: file DB nằm ở `app-data/db.sqlite`, ngoài git repo.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Module Lịch trình
// ---------------------------------------------------------------------------

/// Mẫu lịch trình (Routine Template) — "config hiện hành" theo AD-2.
/// Chỉ tồn tại đúng một hàng (singleton) cho người dùng cục bộ duy nhất (AD-5).
/// Sửa Mẫu KHÔNG bao giờ ghi đè lên `LichTrinhNgay` đã phát sinh — hai bảng
/// tách biệt hoàn toàn ở tầng vật lý (AD-2).
model MauLichTrinh {
  id    Int    @id @default(autoincrement())
  tasks Task[]
}

/// Task mặc định của Mẫu lịch trình.
/// Theo AD-2 đây là bảng riêng, KHÔNG dùng chung với Task của một
/// `LichTrinhNgay` cụ thể (bảng đó thuộc Story 2, chưa tồn tại).
model Task {
  id Int @id @default(autoincrement())

  /// Tên việc — bắt buộc, không được rỗng.
  ten String

  /// Thời hạn: một khung giờ TRONG chính ngày đó, dạng "HH:mm" (24h).
  /// Lưu String thay vì DateTime vì đây là time-of-day không gắn với một ngày
  /// cụ thể nào — Mẫu là bản cấu hình, không phải dữ liệu của một ngày.
  thoiHan String

  /// Mức ưu tiên: "Cao" | "TrungBinh" | "Thap".
  /// SQLite không hỗ trợ enum trong Prisma, nên lưu String và ép ràng buộc ở
  /// tầng ứng dụng — xem `MUC_UU_TIEN` trong `app/lich-trinh/model.ts`.
  mucUuTien String

  mauLichTrinhId Int
  mauLichTrinh   MauLichTrinh @relation(fields: [mauLichTrinhId], references: [id], onDelete: Cascade)

  @@index([mauLichTrinhId])
}

/// Lịch trình ngày (Daily Schedule) — một hàng LỊCH SỬ cho mỗi ngày lịch,
/// theo AD-2 tách vật lý hoàn toàn khỏi `MauLichTrinh`/`Task`: không share
/// hàng/FK giữa hai bộ model, chỉ copy giá trị field tại thời điểm khởi tạo.
/// Được tạo lười qua đúng một Server Action `taoLichTrinhNgayTuMau()` (AD-3
/// ngoại lệ 2) — không bao giờ UPDATE một hàng đã tồn tại từ ngày đã qua.
model LichTrinhNgay {
  id Int @id @default(autoincrement())

  /// Mốc 00:00 giờ Asia/Ho_Chi_Minh của ngày này — khoá unique, tính DUY NHẤT
  /// qua `layMocNgayVN()` ở `lib/ngayVn.ts`, không bao giờ dùng giờ UTC làm mốc.
  ngay DateTime @unique

  tasks TaskNgay[]
}

/// Task của một `LichTrinhNgay` cụ thể — copy giá trị field từ `Task` của
/// Mẫu tại thời điểm khởi tạo ngày đó (AD-2). Sửa/thêm/xoá ở đây KHÔNG BAO GIỜ
/// viết lên `MauLichTrinh`/`Task`.
model TaskNgay {
  id Int @id @default(autoincrement())

  ten       String
  thoiHan   String
  mucUuTien String

  /// Đã xong / Chưa xong — check-off một-cú-bấm, không có bước xác nhận (FR-3).
  daXong Boolean @default(false)

  lichTrinhNgayId Int
  lichTrinhNgay   LichTrinhNgay @relation(fields: [lichTrinhNgayId], references: [id], onDelete: Cascade)

  @@index([lichTrinhNgayId])
}

// ---------------------------------------------------------------------------
// Module Chi tiêu
// ---------------------------------------------------------------------------

/// Danh mục chi tiêu (Expense Category) — nhóm phân loại các Giao dịch Chi.
/// Story 3 chỉ hỗ trợ TẠO Danh mục (inline ngay trong luồng ghi Giao dịch);
/// không có sửa/xoá/đổi tên Danh mục ở story này (Boundaries — Never).
model DanhMucChiTieu {
  id  Int    @id @default(autoincrement())
  ten String

  giaoDich GiaoDich[]
  nganSach NganSach[]
}

/// Giao dịch (Transaction) — một khoản Chi hoặc Thu.
/// `soTien` luôn là Int dương; chiều Chi/Thu xác định bởi cột `loai` (enum),
/// KHÔNG BAO GIỜ mã hoá bằng dấu số (Data & formats convention).
model GiaoDich {
  id Int @id @default(autoincrement())

  /// "Chi" | "Thu". SQLite không hỗ trợ enum trong Prisma, nên lưu String và
  /// ép ràng buộc ở tầng ứng dụng — xem `LOAI_GIAO_DICH`/`laLoaiGiaoDich()`
  /// trong `app/chi-tieu/model.ts`.
  loai String

  /// VNĐ, số nguyên dương — không âm, không thập phân.
  soTien Int

  /// Ngày phát sinh Giao dịch — mốc 00:00 giờ Asia/Ho_Chi_Minh, tính qua
  /// `layMocNgayVN()`/`tuThamSoNgay()` ở `lib/ngayVn.ts`, không dùng UTC.
  ngay DateTime

  /// Ghi chú tuỳ chọn.
  ghiChu String?

  /// Bắt buộc khi `loai == "Chi"`, luôn `null` khi `loai == "Thu"` — ép ở
  /// tầng Server Action (`kiemTraGiaoDich()`, `app/chi-tieu/actions.ts`),
  /// không chỉ dựa vào việc cột này cho phép null.
  danhMucChiTieuId Int?
  danhMucChiTieu   DanhMucChiTieu? @relation(fields: [danhMucChiTieuId], references: [id], onDelete: Restrict)

  @@index([ngay])
  @@index([danhMucChiTieuId])
}

/// Ngân sách (Budget) — hạn mức Chi theo tháng cho một Danh mục.
/// "config hiện hành" theo AD-2: một hàng LUÔN gắn với đúng một tháng
/// (`danhMucChiTieuId`, `thang`) — set/sửa CHỈ upsert hàng của THÁNG HIỆN
/// TẠI (giờ VN), không bao giờ UPDATE hàng của một tháng đã qua. Mirror
/// `LichTrinhNgay`'s day-keyed upsert (`app/lich-trinh/actions.ts:236-251`).
model NganSach {
  id Int @id @default(autoincrement())

  /// Mốc 00:00 giờ Asia/Ho_Chi_Minh của NGÀY ĐẦU THÁNG này — tính DUY NHẤT
  /// qua `layMocDauThangVN()` ở `lib/ngayVn.ts`, không dùng UTC làm mốc.
  thang DateTime

  /// VNĐ, số nguyên dương — cùng biên với `GiaoDich.soTien` (`SO_TIEN_TOI_DA`,
  /// `app/chi-tieu/actions.ts`).
  hanMuc Int

  danhMucChiTieuId Int
  danhMucChiTieu   DanhMucChiTieu @relation(fields: [danhMucChiTieuId], references: [id], onDelete: Restrict)

  @@unique([danhMucChiTieuId, thang])
}

// ---------------------------------------------------------------------------
// Module Thực đơn
// ---------------------------------------------------------------------------

/// Món ăn (Dish) — một hàng trong Ngân hàng món ăn (CAP-8). Module Thực đơn sở
/// hữu độc quyền model này (AD-1) — module khác (kể cả tầng tổng hợp
/// `app/(dashboard)`, khi tồn tại) không được đọc/ghi trực tiếp, chỉ được gọi
/// qua các hàm `queries.ts`/`actions.ts` của module này.
model MonAn {
  id Int @id @default(autoincrement())

  /// Tên món — bắt buộc, không được rỗng.
  ten String

  /// Đường dẫn ảnh TƯƠNG ĐỐI so với chính `app-data/uploads/` (ví dụ
  /// "mon-an/<uuid>.jpg", KHÔNG BAO GIỜ tính từ gốc repo hay gốc dự án) — ghi
  /// và đọc lại đều qua đúng một hàm dùng chung `resolveUploadPath()`
  /// (`lib/resolveUploadPath.ts`, AD-4). KHÔNG BAO GIỜ lưu dữ liệu nhị phân
  /// trong Prisma. `null` khi món chưa có ảnh (ảnh là tuỳ chọn).
  anh String?

  nguyenLieu NguyenLieu[]

  /// Story 7 (CAP-9/CAP-10) — hai nhánh Thực đơn ngày tham chiếu Món ăn này.
  /// `onDelete: Restrict` trên cả hai nhánh (xem dưới) chặn xoá một Món ăn
  /// còn đang được gán trong bất kỳ Thực đơn ngày nào (Boundaries).
  thucDonNguoiLon ThucDonNguoiLon[]
  thucDonBe       ThucDonBe[]
}

/// Nguyên liệu (Ingredient) — một thành phần của một `MonAn` cụ thể, có tên và
/// một ảnh tuỳ chọn riêng (cùng quy ước đường dẫn tương đối với `MonAn.anh`).
/// Xoá `MonAn` cascade xoá luôn các `NguyenLieu` của nó — không orphan HÀNG DB
/// (file ảnh trên đĩa thì có thể orphan, chấp nhận ở v1, xem story's I/O
/// matrix "Delete a Món ăn").
model NguyenLieu {
  id Int @id @default(autoincrement())

  ten String
  anh String?

  monAnId Int
  monAn   MonAn @relation(fields: [monAnId], references: [id], onDelete: Cascade)

  @@index([monAnId])
}

// ---------------------------------------------------------------------------
// Module Thực đơn — Thực đơn ngày (Story 7, CAP-9/CAP-10)
// ---------------------------------------------------------------------------

/// Thực đơn ngày — nhánh "Người lớn & bé 4 tuổi" (CAP-9). Vật lý TÁCH BIỆT
/// HOÀN TOÀN khỏi `ThucDonBe` bên dưới (Structural Seed) — không dùng chung
/// một bảng với cột discriminator/branch. Đúng một hàng cho mỗi (ngay, buoi)
/// (`@@unique([ngay, buoi])`): gán lại một bữa đã có UPDATE hàng đó, không
/// bao giờ tạo thêm hàng thứ hai cho cùng slot (Boundaries: "exactly one Món
/// ăn per slot").
///
/// `ghiChu` (FR-10/CAP-10) chỉ tồn tại về mặt CẤU TRÚC ở đây — `ThucDonBe`
/// không có cột này, không phải một cột dùng chung rồi ẩn đi.
model ThucDonNguoiLon {
  id Int @id @default(autoincrement())

  /// Mốc 00:00 giờ Asia/Ho_Chi_Minh của ngày này — tính qua `layMocNgayVN()`/
  /// `tuThamSoNgay()` ở `lib/ngayVn.ts`, không dùng UTC làm mốc.
  ngay DateTime

  /// "Sang" | "Trua" | "Toi" — SQLite không hỗ trợ enum trong Prisma, nên lưu
  /// String và ép ràng buộc ở tầng ứng dụng, xem `BUOI`/`laBuoi()` trong
  /// `app/thuc-don/model.ts`.
  buoi String

  /// Ghi chú điều chỉnh riêng cho bé 4 tuổi — LUÔN tuỳ chọn (FR-10: không
  /// nhập không cản trở việc lưu).
  ghiChu String?

  monAnId Int
  /// Xoá một Món ăn đang được gán ở đây bị CHẶN (`onDelete: Restrict`) — mirror
  /// `GiaoDich`/`NganSach`'s quan hệ tới `DanhMucChiTieu`, không bao giờ cascade
  /// xoá âm thầm làm mất lịch sử Thực đơn đã lưu.
  monAn MonAn @relation(fields: [monAnId], references: [id], onDelete: Restrict)

  @@unique([ngay, buoi])
  @@index([monAnId])
}

/// Thực đơn ngày — nhánh "Bé dưới 1 tuổi" (CAP-9). Bảng Prisma RIÊNG HOÀN
/// TOÀN khỏi `ThucDonNguoiLon` ở trên — cùng shape ngoại trừ KHÔNG có cột
/// `ghiChu` (FR-10 chỉ áp cho nhánh Người lớn, Structural Seed).
model ThucDonBe {
  id Int @id @default(autoincrement())

  ngay DateTime
  buoi String

  monAnId Int
  monAn   MonAn @relation(fields: [monAnId], references: [id], onDelete: Restrict)

  @@unique([ngay, buoi])
  @@index([monAnId])
}

// ---------------------------------------------------------------------------
// Module Học tập
// ---------------------------------------------------------------------------

/// Buổi học (Study Session) — một lần ghi log học cho một Kỹ năng (CAP-11,
/// Story 8). Module Học tập sở hữu độc quyền model này (AD-1) — module khác
/// không được đọc/ghi trực tiếp.
///
/// Story 8 chỉ hỗ trợ GHI (không có xem lịch sử/tổng thời lượng/streak — đó
/// là CAP-12, Story 9; không có LoTrinh/Moc/BaiTestDanhGia — CAP-13, Story
/// 10, chưa tồn tại).
model BuoiHoc {
  id Int @id @default(autoincrement())

  /// "TiengAnh" | "AutomationTest". SQLite không hỗ trợ enum trong Prisma,
  /// nên lưu String và ép ràng buộc ở tầng ứng dụng — xem
  /// `KY_NANG`/`laKyNang()` trong `app/hoc-tap/model.ts` (mirror
  /// `MUC_UU_TIEN`/`BUOI`/`loai`'s established String-enum pattern).
  kyNang String

  /// Nội dung đã học — bắt buộc, không được rỗng.
  noiDung String

  /// Thời lượng buổi học, tính bằng phút — số nguyên dương, chặn ở tầng ứng
  /// dụng bằng biên Int32 (mirror `SO_TIEN_TOI_DA`, `app/chi-tieu/actions.ts`).
  thoiLuongPhut Int

  /// Mốc 00:00 giờ Asia/Ho_Chi_Minh của NGÀY GHI — luôn stamp bằng
  /// `layMocNgayVN()` tại thời điểm tạo, KHÔNG có trường ngày cho người dùng
  /// tự sửa (Boundaries: đây là một trong ba thao tác "ghi nhanh", không có
  /// backdating UI).
  ngay DateTime

  @@index([kyNang])
  @@index([ngay])
}
